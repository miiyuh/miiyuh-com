# Payload / MongoDB
DATABASE_URI=mongodb://localhost:27017/miiyuh-com
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site URL (used for serverURL, live preview, and WebAuthn defaults)
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# Draft preview
PREVIEW_SECRET=replace-with-a-long-random-string

# Cloudflare R2 (media storage) - optional, falls back to local disk if unset
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
BLOB_READ_WRITE_TOKEN=

# WebAuthn / passkey login for the admin panel - optional
# Defaults are derived from NEXT_PUBLIC_PAYLOAD_URL; only set these if the
# admin panel is served from a different host/subdomain than the RP ID, or if
# you need to allow multiple origins (comma-separated).
# WEBAUTHN_RP_ID=miiyuh.com
# WEBAUTHN_RP_NAME=miiyuh CMS
# WEBAUTHN_ORIGIN=https://miiyuh.com
